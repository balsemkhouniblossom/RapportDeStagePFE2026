@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam defaultFontSize 15
title Administrateur : ordres de travail, pannes, stocks et documents
actor "Administrateur" as Admin
rectangle "Plateforme GMAO" {
package "Ordres de travail" {
usecase "Gérer les ordres de travail" as WO
usecase "Créer un ordre de travail" as CW
usecase "Mettre à jour un ordre de travail" as UW
usecase "Supprimer un ordre de travail" as DW
usecase "Consulter le calendrier des OT" as WC
usecase "Replanifier un OT ou un événement" as RW
usecase "Compléter un ordre de travail" as CO
usecase "Valider un ordre de travail" as VW
usecase "Consulter les statistiques des OT" as WS
usecase "Gérer les rapports d'intervention" as IR
}
package "Pannes, stocks et documents" {
usecase "Gérer le référentiel des pannes" as MF
usecase "Gérer les solutions de panne" as FS
usecase "Gérer le stock" as ST
usecase "Ajuster le stock" as AS
usecase "Consulter les mouvements de stock" as SM
usecase "Gérer le catalogue des pièces" as CA
usecase "Gérer les pièces liées aux OT" as OP
usecase "Gérer les lubrifiants" as LU
usecase "Gérer les journaux de lubrification" as LL
usecase "Gérer les documents techniques" as DO
usecase "Publier ou archiver un document" as PD
}
}
Admin --> WO
Admin --> CW
Admin --> UW
Admin --> DW
Admin --> WC
Admin --> RW
Admin --> CO
Admin --> VW
Admin --> WS
Admin --> IR
Admin --> MF
Admin --> FS
Admin --> ST
Admin --> AS
Admin --> SM
Admin --> CA
Admin --> OP
Admin --> LU
Admin --> LL
Admin --> DO
Admin --> PD
WO ..> CW : <<include>>
WO ..> UW : <<include>>
WO ..> DW : <<include>>
WO ..> WC : <<include>>
WO ..> RW : <<extend>>
WO ..> CO : <<extend>>
WO ..> VW : <<include>>
ST ..> AS : <<extend>>
ST ..> SM : <<include>>
@enduml
