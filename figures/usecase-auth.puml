@startuml
left to right direction
skinparam dpi 160
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam nodesep 22
skinparam ranksep 36
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #334155
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}

actor "Visiteur" as Visitor
actor "Utilisateur\nauthentifié" as User
actor "Administrateur" as Admin

User <|-- Admin

rectangle "Plateforme GMAO -- Gestion des accès" {
  usecase "S'inscrire" as UC_Register
  usecase "Vérifier l'adresse\nélectronique" as UC_Verify
  usecase "Se connecter" as UC_Login
  usecase "Se connecter\navec Google" as UC_Google
  usecase "Compléter le profil" as UC_Complete
  usecase "Réinitialiser\nle mot de passe" as UC_Reset
  usecase "Gérer son profil" as UC_Profile
  usecase "Se déconnecter" as UC_Logout
  usecase "Gérer les\nutilisateurs" as UC_Users
  usecase "Approuver ou\nrejeter un compte" as UC_Approve
  usecase "Attribuer un rôle" as UC_Role
}

Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_Google
Visitor --> UC_Reset

User --> UC_Complete
User --> UC_Profile
User --> UC_Logout

Admin --> UC_Users
Admin --> UC_Approve
Admin --> UC_Role

UC_Register ..> UC_Verify : <<include>>
UC_Google ..> UC_Complete : <<extend>>
UC_Approve ..> UC_Users : <<extend>>
UC_Role ..> UC_Users : <<extend>>
@enduml
