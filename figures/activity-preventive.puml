@startuml
skinparam dpi 160
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #334155
skinparam ActivityDiamondBackgroundColor #EEF2F7
skinparam ActivityDiamondBorderColor #334155
skinparam ArrowColor #334155

start
:Créer ou importer le plan préventif;
:Associer le plan à une machine\nou à un module;
:Définir les tâches, la fréquence\net l'unité de planification;
:Planifier la première occurrence;
:Affecter l'occurrence à un opérateur;

repeat
  :Exécuter les tâches\nde la liste de contrôle;
  :Renseigner les résultats\net les observations;
  :Soumettre l'intervention;

  if (Intervention conforme ?) then (oui)
    :Valider l'intervention;
    :Générer automatiquement\nla prochaine échéance;
  else (non)
    :Rejeter ou demander\nune correction;
    :Réexécuter les tâches;
  endif
repeat while (Prochaine occurrence planifiée ?)

stop
@enduml
