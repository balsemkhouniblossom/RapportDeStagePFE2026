@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}

title Vue globale des cas d'utilisation - GMAO industrielle

actor "Administrateur" as Admin
actor "Opérateur" as Operator
actor "Technicien" as Technician
actor "Équipement connecté" as Device
actor "Service de messagerie" as Mail
actor "Service de stockage" as Storage
actor "Service d'analyse IA" as AI
actor "Planificateur automatique" as Scheduler

rectangle "Système GMAO" {
 usecase "S'authentifier et gérer\nson compte" as Auth
 usecase "Administrer les utilisateurs\net les référentiels" as AdminRef
 usecase "Gérer les équipements\net les documents" as Assets
 usecase "Planifier et exécuter la\nmaintenance préventive" as Preventive
 usecase "Déclarer et traiter une\nmaintenance corrective" as Corrective
 usecase "Gérer les ordres de travail\net les pièces" as WO
 usecase "Consulter les rapports\net les indicateurs" as Reporting
 usecase "Recevoir les\nnotifications" as Notifications
 usecase "Superviser les équipements\nconnectés" as Monitoring
 usecase "Analyser et valider les\nanomalies" as Anomalies
}

Admin -- Auth
Admin -- AdminRef
Admin -- Assets
Admin -- Preventive
Admin -- Corrective
Admin -- WO
Admin -- Reporting
Admin -- Notifications
Admin -- Monitoring
Admin -- Anomalies

Operator -- Auth
Operator -- Assets
Operator -- Preventive
Operator -- Corrective
Operator -- Reporting
Operator -- Notifications

Technician -- Auth
Technician -- Assets
Technician -- Preventive
Technician -- Corrective
Technician -- WO
Technician -- Reporting
Technician -- Notifications
Technician -- Anomalies

Device -- Monitoring
Mail -- Notifications
Storage -- Assets
AI -- Anomalies
Scheduler -- Preventive
Scheduler -- Notifications

Corrective ..> WO : <<include>>
Preventive ..> WO : <<include>>
Anomalies ..> Monitoring : <<extend>>
@enduml
